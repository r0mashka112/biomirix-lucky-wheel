{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy server:8000 {
			header_up X-Forwarded-Proto {$UPSTREAM_FORWARDED_PROTO}
			header_up X-Real-IP {remote_host}
		}
	}

	handle /admin* {
		reverse_proxy server:8000 {
			header_up X-Forwarded-Proto {$UPSTREAM_FORWARDED_PROTO}
			header_up X-Real-IP {remote_host}
		}
	}

	handle /static/* {
		reverse_proxy server:8000 {
			header_up X-Forwarded-Proto {$UPSTREAM_FORWARDED_PROTO}
			header_up X-Real-IP {remote_host}
		}
	}

	handle /webhook {
		reverse_proxy client:3000 {
			header_up X-Forwarded-Proto {$UPSTREAM_FORWARDED_PROTO}
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		root * /srv/static
		try_files {path} {path}/ /index.html
		file_server
	}
}
